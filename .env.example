# GEMINI_API_KEY：Gemini AI 接口所需。
# AI Studio 会在运行时自动从用户密钥中注入。
# 用户可在 AI Studio 的 Secrets 面板中配置。
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL：应用托管地址。
# AI Studio 会在运行时自动注入 Cloud Run 服务地址。
# 用于自引用链接、OAuth 回调和 API 端点。
APP_URL="MY_APP_URL"

# 后端 Flask API 地址；本地默认 http://127.0.0.1:5050
VITE_API_BASE_URL="http://127.0.0.1:5050"

# MySQL 用户注册/登录存储配置
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="dongshu_platform"

# AI问答配置；参考同花顺项目，前端直接调用兼容chat completions接口
VITE_AI_API_KEY=""
VITE_AI_API_URL="https://api.deepseek.com/v1/chat/completions"
VITE_AI_MODEL="deepseek-chat"

# Vercel Function 服务端 AI 配置，生产环境建议使用 AI_API_KEY 或 DEEPSEEK_API_KEY
AI_API_KEY=""
AI_API_URL="https://api.deepseek.com/v1/chat/completions"
AI_MODEL="deepseek-chat"
